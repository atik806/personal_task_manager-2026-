# Copy this file to `.env` and fill in the values from your Supabase project.
# Dashboard → Settings → API.

# Project URL (e.g. https://abcdefghijklm.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Public anon key (safe to embed in the client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the password-reset link should send the user.
# For the native flow this MUST be the app's deep link, matching the `scheme`
# in app.json, e.g. daymark://reset-password. (Supabase email templates need
# {EXPO_PUBLIC_RESET_REDIRECT_URL} as the "Confirm button URL".)
# Leave empty when developing locally with Expo Go.
EXPO_PUBLIC_RESET_REDIRECT_URL=
