# Copy this file to `.env` and fill in the values from your Supabase project.
# Dashboard → Settings → API.

# Project URL (e.g. https://abcdefghijklm.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Public anon key (safe to embed in the client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the password-reset link should send the user.
# Leave empty when developing locally with Expo Go; set it to your web
# deployment when you want "Forgot password?" to deep-link back into the app.
EXPO_PUBLIC_RESET_REDIRECT_URL=
